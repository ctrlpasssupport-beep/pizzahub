# ==============================================================================
# Subday Pizza (PizzaHub) - Environment Configuration Template (.env.example)
# Duplicate this file to .env and configure keys for your environment.
# ==============================================================================

# Server Runtime
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. Firebase (Firestore & Firebase Authentication)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_OAUTH_CLIENT_ID=

# ------------------------------------------------------------------------------
# 2. Google APIs & AI Studio
# ------------------------------------------------------------------------------
# Google Cloud / Firebase API Key
GOOGLE_API_KEY=

# Google Gemini AI API Key (Server-side AI Studio integration)
GEMINI_API_KEY=

# Google Maps Platform (Client key for interactive maps)
VITE_GOOGLE_MAPS_API_KEY=

# Google OAuth 2.0 Web Client ID
VITE_GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------------------
# 3. Supabase Integration
# ------------------------------------------------------------------------------
# Client-side access (Vite bundle)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side access
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 4. Resend (Email Delivery Service)
# ------------------------------------------------------------------------------
RESEND_API_KEY=

# ------------------------------------------------------------------------------
# 5. Database & Migrations (PostgreSQL / Drizzle)
# ------------------------------------------------------------------------------
DATABASE_URL=
LOVABLE_DB_MIGRATION_URL=

# ------------------------------------------------------------------------------
# 6. Security & Webhook Secrets
# ------------------------------------------------------------------------------
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=

# ------------------------------------------------------------------------------
# 7. Store Contact & WhatsApp Details
# ------------------------------------------------------------------------------
VITE_STORE_PHONE=8796130029
VITE_STORE_WHATSAPP=918796130029
VITE_STORE_NAME="Subday Pizza"
VITE_STORE_LOCATION="Sector 4, Gurugram, Haryana"
